# =============================================================================
# AgentOps v3 environment (see CLAUDE_agent_v3.md Section 7)
# All of these are read and validated in ONE place: src/config/env.ts
# =============================================================================

# --- Core secrets (required) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram IDs of approved users. May be empty at first run:
# message the bot, then read your rejected ID from the logs and add it here.
ALLOWED_TELEGRAM_USER_IDS=
DEEPSEEK_API_KEY=
GITHUB_PAT=

# --- LLM (Layer A: swappable by config alone) ---
# Defaults to deepseek-v4-flash if unset. LLM_BASE_URL defaults to https://api.deepseek.com
LLM_MODEL=
LLM_BASE_URL=

# --- GitHub repos (Layer E) ---
# Free-write scratch space for the agent.
GITHUB_PLAYGROUND_REPO=
# Comma-separated allow-list of repos the agent may open PRs/issues into (owner/repo,owner/repo).
# Never org-wide; the PAT must be scoped to exactly these repos + the playground.
ALLOWED_TARGET_REPOS=
# SEPARATE, narrower allow-list for the one irreversible action: deleting a repo (owner/repo,...).
# Deliberately distinct from ALLOWED_TARGET_REPOS - receiving a PR into a repo is not the same as
# being willing to destroy it. Empty/unset => every delete is refused (the safe default). Must be
# FULL owner/repo entries; the PAT needs delete rights (Administration: write) to actually delete.
GITHUB_DELETABLE_REPOS=

# --- Memory store ---
# Phase 4 migration: a standard Redis (local now, VPS later), via ioredis. When set, this takes
# precedence over Upstash below. This is the target the agent runs on after the VPS cutover.
REDIS_URL=redis://localhost:6379
# Upstash Redis (Layer D), REST API. Used only when REDIS_URL is unset. Kept during migration as a
# rollback path; remove after the VPS runs clean for a stable period. If none of these are set, the
# app falls back to an in-memory store that does NOT persist across restarts (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Addressing gate (Phase 4, Section 3a) ---
# The agent's own @handle, used to decide if a GROUP message is addressed to it. Optional - if
# unset, it's resolved from Telegram getMe at startup. With or without the leading '@'.
AGENT_TELEGRAM_HANDLE=
# Loop-breaker cap: max consecutive non-human turns before the agent goes silent until a human
# speaks (Phase 4, Section 3b). Defaults to 3 if unset.
MAX_CONSECUTIVE_BOT_TURNS=3

# --- Vercel webhook only (not needed for local polling) ---
TELEGRAM_WEBHOOK_SECRET=

# --- Backward-compatible fallbacks (v2 names; still read if the v3 names above are unset) ---
# GITHUB_PR_REPOS is used if ALLOWED_TARGET_REPOS is empty.
GITHUB_PR_REPOS=
